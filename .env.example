# Скопируй в .env (cp .env.example .env) и поправь значения.
# .env в git не попадает — см. .gitignore.

# --- Django ---
SECRET_KEY=change-me-to-something-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- База данных ---
# Локально без Docker (Postgres на своей машине):
#   DATABASE_URL=postgres://fixam:fixam@localhost:5432/fixam
# Внутри Docker хост базы — имя сервиса из docker-compose.yml, то есть "db":
DATABASE_URL=postgres://fixam:fixam@db:5432/fixam

# --- Postgres (эти читает контейнер базы при первом запуске) ---
POSTGRES_DB=fixam
POSTGRES_USER=fixam
POSTGRES_PASSWORD=fixam
