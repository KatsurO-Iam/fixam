# Образ = "снимок" готовой машины с нашим приложением внутри.
# Каждая инструкция ниже — слой; Docker кэширует слои, поэтому порядок важен:
# то, что меняется редко (зависимости), ставим раньше того, что меняется часто (код).

# Django 6.1 требует Python >= 3.12. slim = без лишних системных пакетов, образ меньше.
FROM python:3.13-slim

# Не писать .pyc-файлы и не буферизовать вывод (логи сразу видны в docker logs).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Рабочая папка внутри контейнера. Все дальнейшие пути относительно неё.
WORKDIR /app

# Сначала копируем ТОЛЬКО requirements.txt и ставим зависимости.
# Пока requirements.txt не менялся, этот слой берётся из кэша, и пересборка
# после правки кода занимает секунды, а не минуты.
COPY requirements.txt .
RUN pip install -r requirements.txt

# Теперь код бэкенда. В dev-режиме docker-compose поверх этого ещё примонтирует
# папку с хоста, чтобы правки подхватывались без пересборки.
COPY backend/ .

# Не запускаем приложение от root — если что-то в контейнере сломают,
# у злоумышленника не будет root-прав внутри него.
RUN useradd --create-home app && chown -R app:app /app
USER app

# Документация: контейнер слушает 8000. Сам по себе порт не открывает —
# это делает docker-compose через ports:.
EXPOSE 8000

# Команда по умолчанию — прод-сервер gunicorn.
# В dev-режиме docker-compose переопределит её на runserver.
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
